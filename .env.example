# Copy to .env locally. Never commit real credentials or personal data.
# Generate locally; API refuses to start without a token of at least 32 characters.
JARVIS_API_TOKEN=replace_with_at_least_32_random_characters

# Generate a URL-safe Base64 string from 32 random bytes. Keep outside Git.
JARVIS_DATA_KEY=replace_with_locally_generated_32_byte_key

# AI MODEL: inference uses a local loopback server; no cloud model endpoint is supported.
# Optional Google and Adzuna connectors below still contact their providers after you configure/consent.
# Recommended starting point: Ollama + Qwen3.5 4B (about 3.3–4 GB model download).
# Download once: ollama pull qwen3.5:4b
JARVIS_LLM_PROVIDER=ollama
JARVIS_LLM_MODEL=qwen3.5:4b

# Ollama server must stay on loopback only. Do not expose it to LAN/Internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Backward-compatible fallback if JARVIS_LLM_MODEL is unset.
OLLAMA_MODEL=qwen3.5:4b

# Alternative local provider: install LM Studio, download and load a local model,
# start its local API server on localhost:1234, then change JARVIS_LLM_PROVIDER=lmstudio.
# Set JARVIS_LLM_MODEL to the exact model id shown by the LM Studio server.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional local-server key, if you enabled API authentication in LM Studio. Never commit a real key.
# LMSTUDIO_API_KEY=

# Local-only storage paths.
JARVIS_DATA_DIR=./backend/data
JARVIS_VAULT_PATH=./backend/data/vault

# API server must bind to loopback for local development.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Opt-in monitoring. When enabled, the companion PC must stay running.
JARVIS_ENABLE_EMAIL_MONITOR=false
JARVIS_EMAIL_POLL_SECONDS=900
JARVIS_ENABLE_JOB_MONITOR=false
JARVIS_JOB_POLL_SECONDS=21600

# Optional Adzuna personal job search API. Keys stay in this local .env only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google writes are OFF by default. To enable Gmail drafts/sending and calendar create/update,
# explicitly set true here, restart JARVIS, then disconnect/re-authorize Google to grant the additional scopes.
# Google may require verification for apps distributed publicly. Review every action in JARVIS first.
JARVIS_ENABLE_GOOGLE_WRITES=false

# Optional Google OAuth. Create your own OAuth Web client in Google Cloud Console.
# Save its client JSON to .secrets/google-oauth-client.json (ignored by Git).
GOOGLE_OAUTH_CLIENT_FILE=./.secrets/google-oauth-client.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth/google/callback
