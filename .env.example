# Copy to .env locally. Never commit real credentials or personal data.
# Generate locally; API refuses to start without a token of at least 32 characters.
JARVIS_API_TOKEN=replace_with_at_least_32_random_characters

# Generate a URL-safe Base64 string from 32 random bytes. Keep outside Git.
JARVIS_DATA_KEY=replace_with_locally_generated_32_byte_key

# Ollama must remain on this same machine. Do not expose it to LAN/Internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Local-only storage paths.
JARVIS_DATA_DIR=./backend/data
JARVIS_VAULT_PATH=./backend/data/vault

# API server must bind to loopback for local development.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Optional Google OAuth. Create your own OAuth Web client in Google Cloud Console.
# Save its client JSON to .secrets/google-oauth-client.json (ignored by Git).
GOOGLE_OAUTH_CLIENT_FILE=./.secrets/google-oauth-client.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth/google/callback
