# Copy to .env locally. Never commit real credentials or personal data.
# Generate a long random value; API refuses to start without it.
JARVIS_API_TOKEN=replace_with_at_least_32_random_characters

# Ollama must remain on this same machine. Do not expose it to the LAN or Internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Local-only storage paths. Keep these outside version control.
JARVIS_DATA_DIR=./backend/data
JARVIS_VAULT_PATH=./backend/data/vault

# API server must bind to loopback for local development.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
